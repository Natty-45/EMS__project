# Copy these into Render -> your service -> Environment

MONGO_URI=mongodb+srv://<user>:<password>@ems.wk4tjy7.mongodb.net/?appName=ems
PORT=8000
NODE_ENV=production

JWT_SECRET=<generate-a-new-64-char-random-string>

# Gmail account used by nodemailer for OTP/verification emails
EMAIL=yourgmail@gmail.com
APP_PASSWORD=<16-char-gmail-app-password>

# Admin seed credentials (seed.js)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<strong-password>

# Public URL of the frontend (Vercel). Used for CORS + Socket.io.
CLIENT_URL=https://YOUR-FRONTEND-URL.vercel.app
